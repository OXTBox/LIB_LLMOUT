------------------------------------------------------------------------------------
-- 4  RUNAWAY RUNTIME   rung 5: two bodies, one brain
-- You are a runtime. One input drives every copy of you at once. SPACE starts a fresh copy at the
-- start tile, but never more than two at a time. A copy that steps on a HANG tile (red X, orange
-- Y) freezes and keeps its slot until you retire it (X key). A frozen copy still weighs down a
-- pad: the magenta B and the orange Y both hold every purple door open while something is on them.
-- Walls and other copies stop a copy; each copy is stopped on its own.
-- ARROWS move   SPACE new copy   X retire a frozen copy   N restart the room   Reach the gold E.
-- Five rooms. The rule set is mirrored by tests/run_solver.py, which proved every room winnable.
------------------------------------------------------------------------------------
local sRunCell, sRunLevel, sRunRows, sRunW, sRunH, sRunC, sRunN, sRunState, sRunMsg, sRunWait
local sRunLastDir, sRunHold, sRunSpawn, sRunDoors, sRunSolid, sRunMoves, sRunDoorOpen
constant kRunLevels = 5

@@RUNTIME_ROWS@@

on Runtime.Start
   put 1 into sRunLevel
   Runtime.Load
end Runtime.Start

on Runtime.Load
   local tText, y, x, tRow, tCh, tWalls, tFloor, tId, i
   Arc.Clean
   put Runtime.Rows(sRunLevel) into tText
   put empty into sRunRows
   put 0 into sRunH
   put 0 into sRunW
   repeat for each line tRow in tText
      add 1 to sRunH
      put tRow into sRunRows[sRunH]
      put max(sRunW, length(tRow)) into sRunW
   end repeat
   -- big rooms are drawn smaller, small rooms larger
   put min(56, 760 div sRunW, 430 div sRunH) into sRunCell
   Mesh.Define "Run.Copy", Mesh.Box(sRunCell * 0.5, sRunCell * 0.5, sRunCell * 0.5)
   Mesh.Define "Run.Flat", Mesh.Box(sRunCell * 0.7, sRunCell * 0.7, 3)
   Mesh.Define "Run.Door", Mesh.Box(sRunCell - 2, sRunCell - 2, 10)
   Mesh.Define "Run.DoorOpen", Mesh.Box(6, sRunCell - 2, 3)
   put Mesh.New() into tWalls
   put Mesh.New() into tFloor
   put empty into sRunDoors
   put 0 into sRunSolid
   repeat with y = 1 to sRunH
      repeat with x = 1 to length(sRunRows[y])
         put char x of sRunRows[y] into tCh
         if tCh is "#" then
            put Mesh.Merge(tWalls, Mesh.Transform(Mesh.Box(sRunCell - 2, sRunCell - 2, 10), 0, 0, 0, Runtime.WX(x - 1), Runtime.WY(y - 1), 0, empty)) into tWalls
         else
            put Mesh.Merge(tFloor, Mesh.Transform(Mesh.Box(sRunCell - 8, sRunCell - 8, 2), 0, 0, 0, Runtime.WX(x - 1), Runtime.WY(y - 1), 6, empty)) into tFloor
            if tCh is "S" then
               put (x - 1) & "," & (y - 1) into sRunSpawn
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "#2E6F8E")
            else if tCh is "E" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "yellow")
            else if tCh is "X" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "red")
            else if tCh is "Y" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "orange")
            else if tCh is "B" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "magenta")
            else if tCh is "D" then
               put Entity.Spawn("Run.Door", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ, "#B060FF") into tId
               put tId & "," after sRunDoors
            end if
         end if
      end repeat
   end repeat
   if sRunDoors is not empty then delete the last char of sRunDoors
   Mesh.Define "Run.Walls", tWalls
   Mesh.Define "Run.Floor", tFloor
   get Entity.Spawn("Run.Walls", 0, 0, kZ, "#3A5FA0")
   get Entity.Spawn("Run.Floor", 0, 0, kZ, "#1C3A55")
   put empty into sRunC
   put 0 into sRunN
   put 0 into sRunMoves
   put "play" into sRunState
   put empty into sRunMsg
   put 0 into sRunWait
   put empty into sRunLastDir
   put 0 into sRunHold
   put false into sRunDoorOpen
   Runtime.Add
   Runtime.Hud
end Runtime.Load

-- world place of a grid cell (0-based)
function Runtime.WX pCol
   return (pCol - (sRunW - 1) / 2) * sRunCell
end Runtime.WX

function Runtime.WY pRow
   return (pRow - (sRunH - 1) / 2) * sRunCell - 20
end Runtime.WY

-- the tile at a 0-based cell; anything outside is wall
function Runtime.Tile pX, pY
   if pX < 0 or pY < 0 or pY >= sRunH then return "#"
   if pX >= length(sRunRows[pY + 1]) then return "#"
   return char (pX + 1) of sRunRows[pY + 1]
end Runtime.Tile

-- a fresh copy at the start tile
on Runtime.Add
   local tX, tY
   put item 1 of sRunSpawn into tX
   put item 2 of sRunSpawn into tY
   add 1 to sRunN
   put empty into sRunC[sRunN]
   put tX into sRunC[sRunN]["x"]
   put tY into sRunC[sRunN]["y"]
   put false into sRunC[sRunN]["hung"]
   put Entity.Spawn("Run.Copy", Runtime.WX(tX), Runtime.WY(tY), kZ, "cyan") into sRunC[sRunN]["id"]
end Runtime.Add

on Runtime.Hud
   Arc.Line "Run.Title", "RUNAWAY RUNTIME   ROOM" && sRunLevel & "/" & kRunLevels, 0, 18
   Arc.Line "Run.Copies", "COPIES" && sRunN & "/2   MOVES" && sRunMoves, 1, 14
   Arc.Line "Run.Msg", sRunMsg, 2, 14
   Arc.Help "ARROWS: MOVE.  SPACE: NEW COPY.  X: RETIRE.  N: RESTART.  M: MENU"
end Runtime.Hud

function Runtime.DirKey
   if Arc.Held(65362) then return "U"
   if Arc.Held(65364) then return "D"
   if Arc.Held(65361) then return "L"
   if Arc.Held(65363) then return "R"
   return empty
end Runtime.DirKey

on Runtime.Step
   local tDir, tGo
   if sRunState is "won" then
      -- the last room: wait for the player; else go on after a short pause
      if sRunLevel >= kRunLevels then
         if Arc.Pressed(32) then
            Runtime.Start
         end if
      else
         add 1 to sRunWait
         if sRunWait >= 40 then
            add 1 to sRunLevel
            Runtime.Load
         end if
      end if
      exit Runtime.Step
   end if
   if Arc.Pressed(110) then
      Runtime.Load
      exit Runtime.Step
   end if
   if Arc.Pressed(32) then Runtime.Do "S"
   if Arc.Pressed(120) then Runtime.Do "K"
   put Runtime.DirKey() into tDir
   put false into tGo
   if tDir is empty then
      put empty into sRunLastDir
      put 0 into sRunHold
   else if tDir is not sRunLastDir then
      put tDir into sRunLastDir
      put 0 into sRunHold
      put true into tGo
   else
      add 1 to sRunHold
      if sRunHold >= 10 and (sRunHold - 10) mod 4 is 0 then put true into tGo
   end if
   if tGo then Runtime.Do tDir
   Runtime.Hud
end Runtime.Step

-- one action: U D L R, S (spawn) or K (retire): same rules as tests/run_solver.py
on Runtime.Do pAct
   local i, j, tDX, tDY, tNX, tNY, tT, tBlocked, tOpen, tMoved
   if pAct is "S" then
      if sRunN >= 2 then
         put "NO MORE THAN TWO COPIES" into sRunMsg
         exit Runtime.Do
      end if
      repeat with i = 1 to sRunN
         if sRunC[i]["x"] is item 1 of sRunSpawn and sRunC[i]["y"] is item 2 of sRunSpawn then
            put "THE START IS TAKEN" into sRunMsg
            exit Runtime.Do
         end if
      end repeat
      Runtime.Add
      put "TEST" & (sRunN - 1) && "STARTS" into sRunMsg
      exit Runtime.Do
   end if
   if pAct is "K" then
      repeat with i = 1 to sRunN
         if sRunC[i]["hung"] is true then
            Entity.Kill sRunC[i]["id"]
            repeat with j = i to sRunN - 1
               put sRunC[j + 1] into sRunC[j]
            end repeat
            delete variable sRunC[sRunN]
            subtract 1 from sRunN
            put "RETIRED A FROZEN COPY" into sRunMsg
            Runtime.Doors
            exit Runtime.Do
         end if
      end repeat
      exit Runtime.Do
   end if
   put 0 into tDX
   put 0 into tDY
   if pAct is "U" then put -1 into tDY
   if pAct is "D" then put 1 into tDY
   if pAct is "L" then put -1 into tDX
   if pAct is "R" then put 1 into tDX
   put Runtime.PadDown() into tOpen
   put false into tMoved
   repeat with i = 1 to sRunN
      if sRunC[i]["hung"] is true then next repeat
      put sRunC[i]["x"] + tDX into tNX
      put sRunC[i]["y"] + tDY into tNY
      put Runtime.Tile(tNX, tNY) into tT
      put false into tBlocked
      if tT is "#" then put true into tBlocked
      if tT is "D" and tOpen is false then put true into tBlocked
      repeat with j = 1 to sRunN
         if j is not i and sRunC[j]["x"] is tNX and sRunC[j]["y"] is tNY then put true into tBlocked
      end repeat
      if tBlocked is false then
         put tNX into sRunC[i]["x"]
         put tNY into sRunC[i]["y"]
         put true into tMoved
         if tT is "X" or tT is "Y" then
            put true into sRunC[i]["hung"]
            Entity.SetColor sRunC[i]["id"], "#777777"
            put "A COPY HUNG. START A FRESH ONE" into sRunMsg
         end if
         Entity.SetPosition sRunC[i]["id"], Runtime.WX(tNX), Runtime.WY(tNY), kZ
      end if
   end repeat
   if tMoved then add 1 to sRunMoves
   Runtime.Doors
   -- win: a running copy on the exit
   repeat with i = 1 to sRunN
      if sRunC[i]["hung"] is false and Runtime.Tile(sRunC[i]["x"], sRunC[i]["y"]) is "E" then
         put "won" into sRunState
         put 0 into sRunWait
         if sRunLevel >= kRunLevels then
            put "THE LAST ROOM.  A RUNTIME GOT OUT.  SPACE TO RUN AGAIN" into sRunMsg
            Arc.Won 4
         else
            put "ROOM CLEAR" into sRunMsg
         end if
         exit repeat
      end if
   end repeat
end Runtime.Do

-- is any copy (hung or not) on a pad?
function Runtime.PadDown
   local i, tT
   repeat with i = 1 to sRunN
      put Runtime.Tile(sRunC[i]["x"], sRunC[i]["y"]) into tT
      if tT is "B" or tT is "Y" then return true
   end repeat
   return false
end Runtime.PadDown

-- doors open or shut to match the pads
on Runtime.Doors
   local tId, tOpen
   put Runtime.PadDown() into tOpen
   if tOpen is sRunDoorOpen then exit Runtime.Doors
   put tOpen into sRunDoorOpen
   repeat for each item tId in sRunDoors
      if tOpen then
         Entity.SetMesh tId, "Run.DoorOpen"
      else
         Entity.SetMesh tId, "Run.Door"
      end if
   end repeat
end Runtime.Doors

function Runtime.State
   local i, tOut
   repeat with i = 1 to sRunN
      put sRunC[i]["x"] & "." & sRunC[i]["y"] & "." & sRunC[i]["hung"] & ";" after tOut
   end repeat
   return sRunState && sRunLevel && sRunN && tOut
end Runtime.State

-- test help: jump to a room
on Runtime.GoLevel pN
   put pN into sRunLevel
   Runtime.Load
end Runtime.GoLevel
