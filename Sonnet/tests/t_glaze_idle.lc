local i
T.Do "Arc.Seed", 3
repeat with i = 1 to 5000
   T.Step "0"
   if word 1 of T.Call("Glaze.State") is not "play" then exit repeat
end repeat
put "idle ended after" && i && ": " & T.Call("Glaze.State") & cr after tLog
put "bad: " & Stub.Bad() & " badhud: " & Stub.BadHud() & " ents: " & Stub.Count() & cr after tLog
return tLog
