local i, k, tWant, tCode
-- the scoring rule against known cases (done in plain numbers, independent of the game)
put "score 1123/1211: " & T.Call("Password.ScoreText", "1123", "1211") & " (want 1,2)" & cr after tLog
put "score 1234/1234: " & T.Call("Password.ScoreText", "1234", "1234") & " (want 4,0)" & cr after tLog
put "score 1111/2222: " & T.Call("Password.ScoreText", "1111", "2222") & " (want 0,0)" & cr after tLog
put "score 5566/6655: " & T.Call("Password.ScoreText", "5566", "6655") & " (want 0,4)" & cr after tLog
put "score 1122/1212: " & T.Call("Password.ScoreText", "1122", "1212") & " (want 2,2)" & cr after tLog
-- a won game: the code is 3,6,1,4
T.Do "Password.Set", "3614"
repeat with k = 1 to 4
   put char k of "3614" into tWant
   repeat with i = 2 to tWant
      T.Tap "65362"
   end repeat
   T.Tap "65363"
end repeat
put "guess now " & T.Call("Password.Guess") & cr after tLog
T.Tap "32"
put "after the right throw: " & T.Call("Password.State") & cr after tLog
-- a lost game: eight wrong throws
T.Tap "32"
T.Do "Password.Set", "6666"
repeat with i = 1 to 12
   T.Tap "32"
end repeat
put "after wrong throws: " & T.Call("Password.State") & cr after tLog
-- barter: a fresh game, hint costs two rows
T.Tap "32"
T.Tap "104"
put "after barter: " & T.Call("Password.State") & " guess " & T.Call("Password.Guess") & " code " & T.Call("Password.Code") & cr after tLog
T.Tap "104"
T.Tap "104"
T.Tap "104"
put "after 4 barters: " & T.Call("Password.State") & cr after tLog
put "bad: " & Stub.Bad() & " badhud: " & Stub.BadHud() & " ents: " & Stub.Count() & cr after tLog
put Stub.AllHud() after tLog
return tLog
