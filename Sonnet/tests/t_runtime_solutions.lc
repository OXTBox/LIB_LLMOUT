local i, k, tS
T.Do "Runtime.GoLevel", 1
put "room 1 solution RRRRRR: " into tS
repeat for each char tC in "RRRRRR"
   switch tC
      case "U"
         T.Tap "65362"
         break
      case "D"
         T.Tap "65364"
         break
      case "L"
         T.Tap "65361"
         break
      case "R"
         T.Tap "65363"
         break
      case "S"
         T.Tap "32"
         break
      case "K"
         T.Tap "120"
         break
   end switch
end repeat
put tS & T.Call("Runtime.State") & cr after tLog
