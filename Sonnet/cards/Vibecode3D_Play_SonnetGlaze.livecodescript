------------------------------------------------------------------------------------
-- 3  GLAZE OVER  (Glaze vs the Cone's guards)   rung 3: risk against reward
-- Hold SPACE: a charm ring grows round Glaze and drains her stamina. Let go: every guard
-- inside the ring is talked round (turns cyan) and goes after its old friends. A converted
-- guard takes one of them with it. A guard that reaches Glaze costs her stamina.
-- ARROWS walk (slowly while charming).  Convince 12 guards before the stamina runs out.
------------------------------------------------------------------------------------
local sGlX, sGlY, sGlStam, sGlRing, sGlRingId, sGlGuard, sGlN, sGlConv, sGlState, sGlMsg
local sGlTicks, sGlSpawnClock, sGlPlayer, sGlHeld
constant kGlNeed = 12
constant kGlRingMax = 200

on Glaze.Start
   local i
   Mesh.Define "Glz.Glaze", Mesh.Prism(6, 14, 32)
   Mesh.Define "Glz.Guard", Mesh.Pyramid(4, 15, 30)
   repeat with i = 1 to 10
      Mesh.Define "Glz.Ring" & i, Mesh.Prism(18, i * 20, 2)
   end repeat
   put 0 into sGlX
   put 100 into sGlY
   put 100 into sGlStam
   put 0 into sGlRing
   put empty into sGlGuard
   put 0 into sGlN
   put 0 into sGlConv
   put 0 into sGlTicks
   put 20 into sGlSpawnClock
   put "play" into sGlState
   put empty into sGlMsg
   put Entity.Spawn("Glz.Glaze", sGlX, sGlY, kZ, "magenta") into sGlPlayer
   put empty into sGlRingId
   put false into sGlHeld
   Glaze.Hud
end Glaze.Start

on Glaze.Hud
   Arc.Line "Glz.Title", "GLAZE OVER", 0, 18
   Arc.Line "Glz.Score", "CONVINCED" && sGlConv & "/" & kGlNeed && "  STAMINA" && round(sGlStam) && "  RING" && round(sGlRing), 1, 14
   Arc.Line "Glz.Msg", sGlMsg, 2, 14
   Arc.Help "ARROWS: WALK.  HOLD SPACE: RING.  LET GO: CONVERT.  M: MENU"
end Glaze.Hud

on Glaze.Step
   local i, tSpeed, tDX, tDY, d
   if sGlState is not "play" then
      if Arc.Pressed(32) then Arc.Again "Glaze"
      exit Glaze.Step
   end if
   add 1 to sGlTicks
   -- walking
   put 5 into tSpeed
   if Arc.Held(32) then put 2.5 into tSpeed
   if Arc.Held(65361) then subtract tSpeed from sGlX
   if Arc.Held(65363) then add tSpeed to sGlX
   if Arc.Held(65362) then subtract tSpeed from sGlY
   if Arc.Held(65364) then add tSpeed to sGlY
   put Arc.Clamp(sGlX, kL + 20, kR - 20) into sGlX
   put Arc.Clamp(sGlY, kT + 20, kB - 20) into sGlY
   Entity.SetPosition sGlPlayer, sGlX, sGlY, kZ
   Entity.SetRotation sGlPlayer, 0, sGlTicks * 0.04, 0
   -- the ring
   if Arc.Held(32) then
      put min(kGlRingMax, sGlRing + 4) into sGlRing
      subtract 0.28 from sGlStam
      Glaze.ShowRing
      if sGlRing >= kGlRingMax or sGlStam <= 0 then
         Glaze.Release
      end if
   else
      if sGlRing > 0 then Glaze.Release
      put min(100, sGlStam + 0.18) into sGlStam
   end if
   Glaze.Guards
   if sGlConv >= kGlNeed then
      put "THEY ALL CAME ROUND.  SPACE TO PLAY AGAIN" into sGlMsg
      put "won" into sGlState
      Arc.Won 3
   else if sGlStam <= 0 then
      put "GLAZE IS OUT OF WORDS.  SPACE TO TRY AGAIN" into sGlMsg
      put "lost" into sGlState
   end if
   Glaze.Hud
end Glaze.Step

on Glaze.ShowRing
   local tN
   put max(1, min(10, ceil(sGlRing / 20))) into tN
   if sGlRingId is empty then
      put Entity.Spawn("Glz.Ring" & tN, sGlX, sGlY, kZ, "magenta") into sGlRingId
   else
      Entity.SetMesh sGlRingId, "Glz.Ring" & tN
      Entity.SetPosition sGlRingId, sGlX, sGlY, kZ
   end if
end Glaze.ShowRing

-- let go: everyone inside the ring is talked round
on Glaze.Release
   local i, tGot
   put 0 into tGot
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false and Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) <= sGlRing then
         put true into sGlGuard[i]["conv"]
         Entity.SetColor sGlGuard[i]["id"], "cyan"
         add 1 to sGlConv
         add 1 to tGot
      end if
   end repeat
   if tGot > 0 then
      put tGot && "TALKED ROUND" into sGlMsg
      FX.Sparks sGlX, sGlY, kZ, 12, "magenta"
   else if sGlRing > 20 then
      put "THE RING CAUGHT NOBODY" into sGlMsg
   end if
   put 0 into sGlRing
   if sGlRingId is not empty then
      Entity.Kill sGlRingId
      put empty into sGlRingId
   end if
end Glaze.Release

on Glaze.Guards
   local i, j, tNearest, tBest, d, tSpeed, tTX, tTY, tLen
   -- a new guard now and then, from the edge
   add 1 to sGlSpawnClock
   if sGlSpawnClock >= max(26, 72 - sGlConv * 3) then
      put 0 into sGlSpawnClock
      if Glaze.Enemies() < 14 then Glaze.Spawn
   end if
   repeat with i = sGlN down to 1
      if sGlGuard[i] is empty then next repeat
      if sGlGuard[i]["conv"] is true then
         -- a convert hunts the nearest of its old friends, else follows Glaze
         put 0 into tNearest
         put 9999 into tBest
         repeat with j = 1 to sGlN
            if sGlGuard[j]["conv"] is false then
               put Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlGuard[j]["x"], sGlGuard[j]["y"]) into d
               if d < tBest then
                  put d into tBest
                  put j into tNearest
               end if
            end if
         end repeat
         put 4.5 into tSpeed
         if tNearest > 0 then
            put sGlGuard[tNearest]["x"] into tTX
            put sGlGuard[tNearest]["y"] into tTY
         else
            put sGlX + 40 into tTX
            put sGlY + 20 into tTY
         end if
      else
         put 1.1 + sGlConv * 0.07 into tSpeed
         put sGlX into tTX
         put sGlY into tTY
      end if
      put Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], tTX, tTY) into tLen
      if tLen > tSpeed then
         add (tTX - sGlGuard[i]["x"]) / tLen * tSpeed to sGlGuard[i]["x"]
         add (tTY - sGlGuard[i]["y"]) / tLen * tSpeed to sGlGuard[i]["y"]
      end if
      Entity.SetPosition sGlGuard[i]["id"], sGlGuard[i]["x"], sGlGuard[i]["y"], kZ
      Entity.SetRotation sGlGuard[i]["id"], 0, sGlTicks * 0.1, 0
   end repeat
   -- contacts: convert vs guard (both go), guard vs Glaze (the guard goes, she pays)
   repeat with i = sGlN down to 1
      if sGlGuard[i] is empty then next repeat
      if sGlGuard[i]["conv"] is false and Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) < 26 then
         subtract 20 from sGlStam
         put "A GUARD GOT THROUGH" into sGlMsg
         FX.Sparks sGlX, sGlY, kZ, 10, "red"
         Glaze.Remove i
         next repeat
      end if
      if sGlGuard[i]["conv"] is true then
         repeat with j = 1 to sGlN
            if j is not i and sGlGuard[j] is not empty and sGlGuard[j]["conv"] is false then
               if Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlGuard[j]["x"], sGlGuard[j]["y"]) < 24 then
                  FX.Sparks sGlGuard[j]["x"], sGlGuard[j]["y"], kZ, 8, "cyan"
                  -- remove the higher index first so the lower one stays valid
                  if i > j then
                     Glaze.Remove i
                     Glaze.Remove j
                  else
                     Glaze.Remove j
                     Glaze.Remove i
                  end if
                  exit repeat
               end if
            end if
         end repeat
      end if
   end repeat
end Glaze.Guards

function Glaze.Enemies
   local i, n
   put 0 into n
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false then add 1 to n
   end repeat
   return n
end Glaze.Enemies

on Glaze.Spawn
   local tSide, tX, tY
   put random(4) into tSide
   switch tSide
      case 1
         put kL + random(kR - kL) into tX
         put kT into tY
         break
      case 2
         put kL + random(kR - kL) into tX
         put kB into tY
         break
      case 3
         put kL into tX
         put kT + random(kB - kT) into tY
         break
      default
         put kR into tX
         put kT + random(kB - kT) into tY
   end switch
   add 1 to sGlN
   put empty into sGlGuard[sGlN]
   put tX into sGlGuard[sGlN]["x"]
   put tY into sGlGuard[sGlN]["y"]
   put false into sGlGuard[sGlN]["conv"]
   put Entity.Spawn("Glz.Guard", tX, tY, kZ, "#B060FF") into sGlGuard[sGlN]["id"]
end Glaze.Spawn

-- removing keeps the order: shift the rest down (counts are small)
on Glaze.Remove i
   local j
   Entity.Kill sGlGuard[i]["id"]
   repeat with j = i to sGlN - 1
      put sGlGuard[j + 1] into sGlGuard[j]
   end repeat
   delete variable sGlGuard[sGlN]
   subtract 1 from sGlN
end Glaze.Remove

function Glaze.State
   return sGlState && sGlConv && round(sGlStam) && sGlN && round(sGlRing)
end Glaze.State

-- test help: where the guards are
function Glaze.Near
   local i, tBest, d, tPick
   put 9999 into tBest
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false then
         put Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) into d
         if d < tBest then
            put d into tBest
            put i into tPick
         end if
      end if
   end repeat
   return tBest
end Glaze.Near

function Glaze.Count
   local i, tN
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false and Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) <= sGlRing + 4 then add 1 to tN
   end repeat
   return tN + 0
end Glaze.Count

