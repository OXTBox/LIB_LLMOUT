------------------------------------------------------------------------------------
-- 2  THE PASSWORD  (Probe and Glaze vs the Cone)   rung 2: one screen of thinking
-- The Cone keeps a password of four symbols (six kinds, repeats allowed). Throw the Probe
-- at a guess: a gold peg = right symbol in the right place, a white peg = right symbol in
-- the wrong place. Eight throws. GLAZE can barter (H): two throws for one slot revealed.
-- LEFT RIGHT pick the slot, UP DOWN change its symbol, SPACE throws.
------------------------------------------------------------------------------------
local sPwLive, sPwCode, sPwGuess, sPwSlot, sPwRow, sPwState, sPwMsg, sPwCur, sPwKnown, sPwHints
constant kPwRows = 8
constant kPwY0 = -190
constant kPwStep = 44

on Password.Start
   local i
   Mesh.Define "Pw.S1", Mesh.Box(26, 26, 26)
   Mesh.Define "Pw.S2", Mesh.Pyramid(4, 16, 30)
   Mesh.Define "Pw.S3", Mesh.Prism(6, 14, 26)
   Mesh.Define "Pw.S4", Mesh.Sphere(14, 3, 6)
   Mesh.Define "Pw.S5", Mesh.Prism(3, 16, 26)
   Mesh.Define "Pw.S6", Mesh.Pyramid(3, 16, 30)
   Mesh.Define "Pw.Peg", Mesh.Box(9, 9, 9)
   Mesh.Define "Pw.Cursor", Mesh.Box(30, 4, 4)
   Mesh.Define "Pw.Cone", Mesh.Pyramid(12, 34, 70)
   Mesh.Define "Pw.Bar", Mesh.Box(150, 2, 2)
   Mesh.Define "Pw.Hid", Mesh.Box(26, 8, 26)
   put empty into sPwCode
   put empty into sPwGuess
   put empty into sPwKnown
   put empty into sPwLive
   repeat with i = 1 to 4
      put random(6) into sPwCode[i]
      put 1 into sPwGuess[i]
   end repeat
   put 1 into sPwSlot
   put 1 into sPwRow
   put 0 into sPwHints
   put "play" into sPwState
   put empty into sPwMsg
   -- the Cone, and a hidden row for its password
   get Entity.Spawn("Pw.Cone", 240, -60, kZ, "#B060FF")
   repeat with i = 1 to 4
      get Entity.Spawn("Pw.Hid", Password.X(i), 230, kZ, "#555555")
   end repeat
   put Entity.Spawn("Pw.Cursor", Password.X(1), Password.RowY(1) + 26, kZ, "yellow") into sPwCur
   Password.DrawRow
   Password.Hud
end Password.Start

function Password.X pSlot
   return -150 + (pSlot - 1) * 56
end Password.X

function Password.RowY pRow
   return kPwY0 + (pRow - 1) * kPwStep
end Password.RowY

on Password.Hud
   Arc.Line "Pw.Title", "THE PASSWORD", 0, 18
   Arc.Line "Pw.Row", "THROW" && min(sPwRow, kPwRows) & "/" & kPwRows && "  HINTS" && sPwHints, 1, 14
   Arc.Line "Pw.Msg", sPwMsg, 2, 14
   Arc.Help "ARROWS: PICK / CHANGE.  SPACE: THROW.  H: BARTER A SLOT.  M: MENU"
end Password.Hud

-- the editing row: four live symbols (killed and redrawn whenever the guess changes)
on Password.DrawRow
   local i, tId
   repeat for each item tId in sPwLive
      Entity.Kill tId
   end repeat
   put empty into sPwLive
   repeat with i = 1 to 4
      put Entity.Spawn("Pw.S" & sPwGuess[i], Password.X(i), Password.RowY(sPwRow), kZ, Password.Color(sPwGuess[i])) into tId
      put tId & "," after sPwLive
   end repeat
   delete the last char of sPwLive
   Entity.SetPosition sPwCur, Password.X(sPwSlot), Password.RowY(sPwRow) + 26, kZ
end Password.DrawRow

function Password.Color pN
   return item pN of "cyan,magenta,yellow,orange,green,white"
end Password.Color

on Password.Step
   if sPwState is not "play" then
      if Arc.Pressed(32) then Arc.Again "Password"
      exit Password.Step
   end if
   if Arc.Pressed(65361) then put max(1, sPwSlot - 1) into sPwSlot
   if Arc.Pressed(65363) then put min(4, sPwSlot + 1) into sPwSlot
   if Arc.Pressed(65362) then
      put sPwGuess[sPwSlot] mod 6 + 1 into sPwGuess[sPwSlot]
   end if
   if Arc.Pressed(65364) then
      put (sPwGuess[sPwSlot] + 4) mod 6 + 1 into sPwGuess[sPwSlot]
   end if
   if Arc.Pressed(104) then Password.Barter
   if Arc.Pressed(32) then Password.Throw
   if sPwState is "play" then Password.DrawRow
   Password.Hud
end Password.Step

-- how many are right in place, and how many right but misplaced
function Password.Score pCode, pGuess
   local i, k, tExact, tCommon, tC, tG
   put 0 into tExact
   put 0 into tCommon
   repeat with i = 1 to 4
      if pCode[i] is pGuess[i] then add 1 to tExact
   end repeat
   repeat with k = 1 to 6
      put 0 into tC
      put 0 into tG
      repeat with i = 1 to 4
         if pCode[i] is k then add 1 to tC
         if pGuess[i] is k then add 1 to tG
      end repeat
      add min(tC, tG) to tCommon
   end repeat
   return tExact & "," & (tCommon - tExact)
end Password.Score

on Password.Throw
   local tScore, tExact, tPresent, i, tY
   put Password.Score(sPwCode, sPwGuess) into tScore
   put item 1 of tScore into tExact
   put item 2 of tScore into tPresent
   put Password.RowY(sPwRow) into tY
   -- the row stays: pegs show the answer
   repeat with i = 1 to tExact
      get Entity.Spawn("Pw.Peg", 52 + i * 14, tY, kZ, "yellow")
   end repeat
   repeat with i = 1 to tPresent
      get Entity.Spawn("Pw.Peg", 52 + (tExact + i) * 14, tY, kZ, "white")
   end repeat
   -- keep this row's symbols as they are: the live ones become the row (new live set next)
   put empty into sPwLive
   FX.Sparks Password.X(sPwSlot), tY, kZ, 6, "cyan"
   if tExact is 4 then
      put "ACCEPTED.  THE CONE OPENS.  SPACE TO PLAY AGAIN" into sPwMsg
      put "won" into sPwState
      Password.Reveal
      Arc.Won 2
      exit Password.Throw
   end if
   add 1 to sPwRow
   if sPwRow > kPwRows then
      put "DENIED.  THE CONE KEEPS ITS WORD.  SPACE TO TRY AGAIN" into sPwMsg
      put "lost" into sPwState
      Password.Reveal
      exit Password.Throw
   end if
   put tExact && "IN PLACE" && tPresent && "MISPLACED" into sPwMsg
   Password.DrawRow
end Password.Throw

on Password.Barter
   local tOpen, i, tPick
   if sPwRow + 2 > kPwRows then
      put "GLAZE CANNOT AFFORD IT" into sPwMsg
      exit Password.Barter
   end if
   repeat with i = 1 to 4
      if sPwKnown[i] is empty then put i & "," after tOpen
   end repeat
   if tOpen is empty then
      put "NOTHING LEFT TO BARTER FOR" into sPwMsg
      exit Password.Barter
   end if
   delete the last char of tOpen
   put item random(the number of items of tOpen) of tOpen into tPick
   put true into sPwKnown[tPick]
   put sPwCode[tPick] into sPwGuess[tPick]
   add 1 to sPwHints
   -- two throws are spent: grey bars over the rows
   get Entity.Spawn("Pw.Bar", -90, Password.RowY(sPwRow) , kZ, "magenta")
   get Entity.Spawn("Pw.Bar", -90, Password.RowY(sPwRow + 1), kZ, "magenta")
   -- show what was learned on the right of the hidden row
   get Entity.Spawn("Pw.S" & sPwCode[tPick], Password.X(tPick), 200, kZ, Password.Color(sPwCode[tPick]))
   add 2 to sPwRow
   put "GLAZE TRADED TWO THROWS: SLOT" && tPick && "IS KNOWN" into sPwMsg
   Password.DrawRow
end Password.Barter

on Password.Reveal
   local i, tId
   repeat for each item tId in sPwLive
      Entity.Kill tId
   end repeat
   put empty into sPwLive
   repeat with i = 1 to 4
      get Entity.Spawn("Pw.S" & sPwCode[i], Password.X(i), 200, kZ, Password.Color(sPwCode[i]))
   end repeat
end Password.Reveal

function Password.State
   return sPwState && sPwRow && sPwHints
end Password.State

-- test help
function Password.Code
   return sPwCode[1] & sPwCode[2] & sPwCode[3] & sPwCode[4]
end Password.Code

on Password.Set pCodeText
   local i
   repeat with i = 1 to 4
      put char i of pCodeText into sPwCode[i]
   end repeat
end Password.Set

function Password.Guess
   return sPwGuess[1] & sPwGuess[2] & sPwGuess[3] & sPwGuess[4]
end Password.Guess

function Password.ScoreText pCodeText, pGuessText
   local i, tC, tG
   repeat with i = 1 to 4
      put char i of pCodeText into tC[i]
      put char i of pGuessText into tG[i]
   end repeat
   return Password.Score(tC, tG)
end Password.ScoreText

