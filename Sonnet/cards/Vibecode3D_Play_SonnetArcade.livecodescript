------------------------------------------------------------------------------------
-- 1  NONSENSE RAIN  (Probe vs Cone)   rung 1: one axis, one rule
-- The Cone rains code. Cubes are valid: catch them. Cones are nonsense: dodge them.
-- Some tokens re-parse on the way down: they flash white, then become the other kind.
-- LEFT RIGHT slide the Probe.  Catch 20 valid tokens; three nonsense hits end it.
------------------------------------------------------------------------------------
local sRnPX, sRnPlayer, sRnTok, sRnN, sRnCaught, sRnLives, sRnTicks, sRnState, sRnMsg, sRnClock
constant kRnNeed = 20

on Rain.Start
   Mesh.Define "Rain.Probe", Mesh.Box(70, 12, 12)
   Mesh.Define "Rain.Valid", Mesh.Box(26, 26, 26)
   Mesh.Define "Rain.Nonsense", Mesh.Pyramid(5, 18, 34)
   put 0 into sRnPX
   put Entity.Spawn("Rain.Probe", 0, kB - 30, kZ, "cyan") into sRnPlayer
   put empty into sRnTok
   put 0 into sRnN
   put 0 into sRnCaught
   put 3 into sRnLives
   put 0 into sRnTicks
   put 0 into sRnClock
   put "play" into sRnState
   put empty into sRnMsg
   Rain.Hud
end Rain.Start

on Rain.Hud
   Arc.Line "Rain.Title", "NONSENSE RAIN", 0, 18
   Arc.Line "Rain.Score", "VALID" && sRnCaught & "/" & kRnNeed && "  LIVES" && sRnLives, 1, 14
   Arc.Line "Rain.Msg", sRnMsg, 2, 14
   Arc.Help "LEFT RIGHT: SLIDE.  CUBES GOOD, CONES BAD.  WHITE FLASH: RE-PARSE.  M: MENU"
end Rain.Hud

on Rain.Step
   local i, tGap, tType, tVY
   if sRnState is not "play" then
      if Arc.Pressed(32) then Arc.Again "Rain"
      exit Rain.Step
   end if
   add 1 to sRnTicks
   if Arc.Held(65361) then subtract 9 from sRnPX
   if Arc.Held(65363) then add 9 to sRnPX
   put Arc.Clamp(sRnPX, kL + 40, kR - 40) into sRnPX
   Entity.SetPosition sRnPlayer, sRnPX, kB - 30, kZ
   -- a new token: faster and meaner the more you have caught
   put max(9, 32 - sRnCaught) into tGap
   add 1 to sRnClock
   if sRnClock >= tGap then
      put 0 into sRnClock
      Rain.Spawn
   end if
   repeat with i = sRnN down to 1
      add sRnTok[i]["vy"] to sRnTok[i]["y"]
      -- re-parse: a tell (white), then the other kind
      if sRnTok[i]["flipAt"] is not empty and sRnTok[i]["y"] >= sRnTok[i]["flipAt"] then
         Rain.Reparse i
      end if
      if sRnTok[i]["tell"] > 0 then
         subtract 1 from sRnTok[i]["tell"]
         if sRnTok[i]["tell"] is 0 then Rain.Flip i
      end if
      Entity.SetPosition sRnTok[i]["id"], sRnTok[i]["x"], sRnTok[i]["y"], kZ
      Entity.SetRotation sRnTok[i]["id"], 0, sRnTicks * 0.05, 0
      if sRnTok[i]["y"] >= kB - 46 and sRnTok[i]["y"] <= kB - 14 and abs(sRnTok[i]["x"] - sRnPX) < 48 then
         Rain.Catch i
      else if sRnTok[i]["y"] > kB + 20 then
         Rain.Drop i
      end if
   end repeat
   if sRnCaught >= kRnNeed then
      put "CODE CLEAN.  SPACE TO RAIN AGAIN" into sRnMsg
      put "won" into sRnState
      Arc.Won 1
   else if sRnLives <= 0 then
      put "TOO MUCH NONSENSE.  SPACE TO TRY AGAIN" into sRnMsg
      put "lost" into sRnState
   end if
   Rain.Hud
end Rain.Step

on Rain.Spawn
   local tType, tFlip
   put "valid" into tType
   if random(100) <= min(70, 34 + sRnCaught) then put "nonsense" into tType
   add 1 to sRnN
   put empty into sRnTok[sRnN]
   put tType into sRnTok[sRnN]["type"]
   put kL + 30 + random(kR - kL - 60) into sRnTok[sRnN]["x"]
   put kT into sRnTok[sRnN]["y"]
   put 3 + random(3) * 0.4 + sRnCaught * 0.1 into sRnTok[sRnN]["vy"]
   put 0 into sRnTok[sRnN]["tell"]
   put empty into sRnTok[sRnN]["flipAt"]
   if random(100) <= 30 then put (random(120) - 60) into sRnTok[sRnN]["flipAt"]
   if tType is "valid" then
      put Entity.Spawn("Rain.Valid", sRnTok[sRnN]["x"], kT, kZ, "cyan") into sRnTok[sRnN]["id"]
   else
      put Entity.Spawn("Rain.Nonsense", sRnTok[sRnN]["x"], kT, kZ, "#B060FF") into sRnTok[sRnN]["id"]
   end if
end Rain.Spawn

on Rain.Reparse i
   put empty into sRnTok[i]["flipAt"]
   put 12 into sRnTok[i]["tell"]
   Entity.SetColor sRnTok[i]["id"], "white"
end Rain.Reparse

on Rain.Flip i
   if sRnTok[i]["type"] is "valid" then
      put "nonsense" into sRnTok[i]["type"]
      Entity.SetMesh sRnTok[i]["id"], "Rain.Nonsense"
      Entity.SetColor sRnTok[i]["id"], "#B060FF"
   else
      put "valid" into sRnTok[i]["type"]
      Entity.SetMesh sRnTok[i]["id"], "Rain.Valid"
      Entity.SetColor sRnTok[i]["id"], "cyan"
   end if
end Rain.Flip

on Rain.Catch i
   if sRnTok[i]["type"] is "valid" then
      add 1 to sRnCaught
      FX.Sparks sRnTok[i]["x"], sRnTok[i]["y"], kZ, 8, "cyan"
   else
      subtract 1 from sRnLives
      FX.Sparks sRnTok[i]["x"], sRnTok[i]["y"], kZ, 14, "red"
   end if
   Rain.Drop i
end Rain.Catch

-- remove token i: the last one takes its place
on Rain.Drop i
   Entity.Kill sRnTok[i]["id"]
   if i < sRnN then put sRnTok[sRnN] into sRnTok[i]
   delete variable sRnTok[sRnN]
   subtract 1 from sRnN
end Rain.Drop

function Rain.State
   return sRnState && sRnCaught && sRnLives && sRnN
end Rain.State

-- test help: where the lowest valid token is (empty when none)
function Rain.Aim
   local i, tBestY, tX
   put -9999 into tBestY
   repeat with i = 1 to sRnN
      if sRnTok[i]["type"] is "valid" and sRnTok[i]["y"] > tBestY then
         put sRnTok[i]["y"] into tBestY
         put sRnTok[i]["x"] into tX
      end if
   end repeat
   return tX
end Rain.Aim

function Rain.Px
   return sRnPX
end Rain.Px

-- test help: "type,x,y" a line each
function Rain.Tokens
   local i, tOut
   repeat with i = 1 to sRnN
      put sRnTok[i]["type"] & "," & round(sRnTok[i]["x"]) & "," & round(sRnTok[i]["y"]) & cr after tOut
   end repeat
   return tOut
end Rain.Tokens

------------------------------------------------------------------------------------
-- 2  THE PASSWORD  (Probe and Glaze vs the Cone)   rung 2: one screen of thinking
-- The Cone keeps a password of four symbols (six kinds, repeats allowed). Throw the Probe
-- at a guess: a gold peg = right symbol in the right place, a white peg = right symbol in
-- the wrong place. Eight throws. GLAZE can barter (H): two throws for one slot revealed.
-- LEFT RIGHT pick the slot, UP DOWN change its symbol, SPACE throws.
------------------------------------------------------------------------------------
local sPwLive, sPwCode, sPwGuess, sPwSlot, sPwRow, sPwState, sPwMsg, sPwCur, sPwKnown, sPwHints
constant kPwRows = 8
constant kPwY0 = -190
constant kPwStep = 44

on Password.Start
   local i
   Mesh.Define "Pw.S1", Mesh.Box(26, 26, 26)
   Mesh.Define "Pw.S2", Mesh.Pyramid(4, 16, 30)
   Mesh.Define "Pw.S3", Mesh.Prism(6, 14, 26)
   Mesh.Define "Pw.S4", Mesh.Sphere(14, 3, 6)
   Mesh.Define "Pw.S5", Mesh.Prism(3, 16, 26)
   Mesh.Define "Pw.S6", Mesh.Pyramid(3, 16, 30)
   Mesh.Define "Pw.Peg", Mesh.Box(9, 9, 9)
   Mesh.Define "Pw.Cursor", Mesh.Box(30, 4, 4)
   Mesh.Define "Pw.Cone", Mesh.Pyramid(12, 34, 70)
   Mesh.Define "Pw.Bar", Mesh.Box(150, 2, 2)
   Mesh.Define "Pw.Hid", Mesh.Box(26, 8, 26)
   put empty into sPwCode
   put empty into sPwGuess
   put empty into sPwKnown
   put empty into sPwLive
   repeat with i = 1 to 4
      put random(6) into sPwCode[i]
      put 1 into sPwGuess[i]
   end repeat
   put 1 into sPwSlot
   put 1 into sPwRow
   put 0 into sPwHints
   put "play" into sPwState
   put empty into sPwMsg
   -- the Cone, and a hidden row for its password
   get Entity.Spawn("Pw.Cone", 240, -60, kZ, "#B060FF")
   repeat with i = 1 to 4
      get Entity.Spawn("Pw.Hid", Password.X(i), 230, kZ, "#555555")
   end repeat
   put Entity.Spawn("Pw.Cursor", Password.X(1), Password.RowY(1) + 26, kZ, "yellow") into sPwCur
   Password.DrawRow
   Password.Hud
end Password.Start

function Password.X pSlot
   return -150 + (pSlot - 1) * 56
end Password.X

function Password.RowY pRow
   return kPwY0 + (pRow - 1) * kPwStep
end Password.RowY

on Password.Hud
   Arc.Line "Pw.Title", "THE PASSWORD", 0, 18
   Arc.Line "Pw.Row", "THROW" && min(sPwRow, kPwRows) & "/" & kPwRows && "  HINTS" && sPwHints, 1, 14
   Arc.Line "Pw.Msg", sPwMsg, 2, 14
   Arc.Help "ARROWS: PICK / CHANGE.  SPACE: THROW.  H: BARTER A SLOT.  M: MENU"
end Password.Hud

-- the editing row: four live symbols (killed and redrawn whenever the guess changes)
on Password.DrawRow
   local i, tId
   repeat for each item tId in sPwLive
      Entity.Kill tId
   end repeat
   put empty into sPwLive
   repeat with i = 1 to 4
      put Entity.Spawn("Pw.S" & sPwGuess[i], Password.X(i), Password.RowY(sPwRow), kZ, Password.Color(sPwGuess[i])) into tId
      put tId & "," after sPwLive
   end repeat
   delete the last char of sPwLive
   Entity.SetPosition sPwCur, Password.X(sPwSlot), Password.RowY(sPwRow) + 26, kZ
end Password.DrawRow

function Password.Color pN
   return item pN of "cyan,magenta,yellow,orange,green,white"
end Password.Color

on Password.Step
   if sPwState is not "play" then
      if Arc.Pressed(32) then Arc.Again "Password"
      exit Password.Step
   end if
   if Arc.Pressed(65361) then put max(1, sPwSlot - 1) into sPwSlot
   if Arc.Pressed(65363) then put min(4, sPwSlot + 1) into sPwSlot
   if Arc.Pressed(65362) then
      put sPwGuess[sPwSlot] mod 6 + 1 into sPwGuess[sPwSlot]
   end if
   if Arc.Pressed(65364) then
      put (sPwGuess[sPwSlot] + 4) mod 6 + 1 into sPwGuess[sPwSlot]
   end if
   if Arc.Pressed(104) then Password.Barter
   if Arc.Pressed(32) then Password.Throw
   if sPwState is "play" then Password.DrawRow
   Password.Hud
end Password.Step

-- how many are right in place, and how many right but misplaced
function Password.Score pCode, pGuess
   local i, k, tExact, tCommon, tC, tG
   put 0 into tExact
   put 0 into tCommon
   repeat with i = 1 to 4
      if pCode[i] is pGuess[i] then add 1 to tExact
   end repeat
   repeat with k = 1 to 6
      put 0 into tC
      put 0 into tG
      repeat with i = 1 to 4
         if pCode[i] is k then add 1 to tC
         if pGuess[i] is k then add 1 to tG
      end repeat
      add min(tC, tG) to tCommon
   end repeat
   return tExact & "," & (tCommon - tExact)
end Password.Score

on Password.Throw
   local tScore, tExact, tPresent, i, tY
   put Password.Score(sPwCode, sPwGuess) into tScore
   put item 1 of tScore into tExact
   put item 2 of tScore into tPresent
   put Password.RowY(sPwRow) into tY
   -- the row stays: pegs show the answer
   repeat with i = 1 to tExact
      get Entity.Spawn("Pw.Peg", 52 + i * 14, tY, kZ, "yellow")
   end repeat
   repeat with i = 1 to tPresent
      get Entity.Spawn("Pw.Peg", 52 + (tExact + i) * 14, tY, kZ, "white")
   end repeat
   -- keep this row's symbols as they are: the live ones become the row (new live set next)
   put empty into sPwLive
   FX.Sparks Password.X(sPwSlot), tY, kZ, 6, "cyan"
   if tExact is 4 then
      put "ACCEPTED.  THE CONE OPENS.  SPACE TO PLAY AGAIN" into sPwMsg
      put "won" into sPwState
      Password.Reveal
      Arc.Won 2
      exit Password.Throw
   end if
   add 1 to sPwRow
   if sPwRow > kPwRows then
      put "DENIED.  THE CONE KEEPS ITS WORD.  SPACE TO TRY AGAIN" into sPwMsg
      put "lost" into sPwState
      Password.Reveal
      exit Password.Throw
   end if
   put tExact && "IN PLACE" && tPresent && "MISPLACED" into sPwMsg
   Password.DrawRow
end Password.Throw

on Password.Barter
   local tOpen, i, tPick
   if sPwRow + 2 > kPwRows then
      put "GLAZE CANNOT AFFORD IT" into sPwMsg
      exit Password.Barter
   end if
   repeat with i = 1 to 4
      if sPwKnown[i] is empty then put i & "," after tOpen
   end repeat
   if tOpen is empty then
      put "NOTHING LEFT TO BARTER FOR" into sPwMsg
      exit Password.Barter
   end if
   delete the last char of tOpen
   put item random(the number of items of tOpen) of tOpen into tPick
   put true into sPwKnown[tPick]
   put sPwCode[tPick] into sPwGuess[tPick]
   add 1 to sPwHints
   -- two throws are spent: grey bars over the rows
   get Entity.Spawn("Pw.Bar", -90, Password.RowY(sPwRow) , kZ, "magenta")
   get Entity.Spawn("Pw.Bar", -90, Password.RowY(sPwRow + 1), kZ, "magenta")
   -- show what was learned on the right of the hidden row
   get Entity.Spawn("Pw.S" & sPwCode[tPick], Password.X(tPick), 200, kZ, Password.Color(sPwCode[tPick]))
   add 2 to sPwRow
   put "GLAZE TRADED TWO THROWS: SLOT" && tPick && "IS KNOWN" into sPwMsg
   Password.DrawRow
end Password.Barter

on Password.Reveal
   local i, tId
   repeat for each item tId in sPwLive
      Entity.Kill tId
   end repeat
   put empty into sPwLive
   repeat with i = 1 to 4
      get Entity.Spawn("Pw.S" & sPwCode[i], Password.X(i), 200, kZ, Password.Color(sPwCode[i]))
   end repeat
end Password.Reveal

function Password.State
   return sPwState && sPwRow && sPwHints
end Password.State

-- test help
function Password.Code
   return sPwCode[1] & sPwCode[2] & sPwCode[3] & sPwCode[4]
end Password.Code

on Password.Set pCodeText
   local i
   repeat with i = 1 to 4
      put char i of pCodeText into sPwCode[i]
   end repeat
end Password.Set

function Password.Guess
   return sPwGuess[1] & sPwGuess[2] & sPwGuess[3] & sPwGuess[4]
end Password.Guess

function Password.ScoreText pCodeText, pGuessText
   local i, tC, tG
   repeat with i = 1 to 4
      put char i of pCodeText into tC[i]
      put char i of pGuessText into tG[i]
   end repeat
   return Password.Score(tC, tG)
end Password.ScoreText

------------------------------------------------------------------------------------
-- 3  GLAZE OVER  (Glaze vs the Cone's guards)   rung 3: risk against reward
-- Hold SPACE: a charm ring grows round Glaze and drains her stamina. Let go: every guard
-- inside the ring is talked round (turns cyan) and goes after its old friends. A converted
-- guard takes one of them with it. A guard that reaches Glaze costs her stamina.
-- ARROWS walk (slowly while charming).  Convince 12 guards before the stamina runs out.
------------------------------------------------------------------------------------
local sGlX, sGlY, sGlStam, sGlRing, sGlRingId, sGlGuard, sGlN, sGlConv, sGlState, sGlMsg
local sGlTicks, sGlSpawnClock, sGlPlayer, sGlHeld
constant kGlNeed = 12
constant kGlRingMax = 200

on Glaze.Start
   local i
   Mesh.Define "Glz.Glaze", Mesh.Prism(6, 14, 32)
   Mesh.Define "Glz.Guard", Mesh.Pyramid(4, 15, 30)
   repeat with i = 1 to 10
      Mesh.Define "Glz.Ring" & i, Mesh.Prism(18, i * 20, 2)
   end repeat
   put 0 into sGlX
   put 100 into sGlY
   put 100 into sGlStam
   put 0 into sGlRing
   put empty into sGlGuard
   put 0 into sGlN
   put 0 into sGlConv
   put 0 into sGlTicks
   put 20 into sGlSpawnClock
   put "play" into sGlState
   put empty into sGlMsg
   put Entity.Spawn("Glz.Glaze", sGlX, sGlY, kZ, "magenta") into sGlPlayer
   put empty into sGlRingId
   put false into sGlHeld
   Glaze.Hud
end Glaze.Start

on Glaze.Hud
   Arc.Line "Glz.Title", "GLAZE OVER", 0, 18
   Arc.Line "Glz.Score", "CONVINCED" && sGlConv & "/" & kGlNeed && "  STAMINA" && round(sGlStam) && "  RING" && round(sGlRing), 1, 14
   Arc.Line "Glz.Msg", sGlMsg, 2, 14
   Arc.Help "ARROWS: WALK.  HOLD SPACE: RING.  LET GO: CONVERT.  M: MENU"
end Glaze.Hud

on Glaze.Step
   local i, tSpeed, tDX, tDY, d
   if sGlState is not "play" then
      if Arc.Pressed(32) then Arc.Again "Glaze"
      exit Glaze.Step
   end if
   add 1 to sGlTicks
   -- walking
   put 5 into tSpeed
   if Arc.Held(32) then put 2.5 into tSpeed
   if Arc.Held(65361) then subtract tSpeed from sGlX
   if Arc.Held(65363) then add tSpeed to sGlX
   if Arc.Held(65362) then subtract tSpeed from sGlY
   if Arc.Held(65364) then add tSpeed to sGlY
   put Arc.Clamp(sGlX, kL + 20, kR - 20) into sGlX
   put Arc.Clamp(sGlY, kT + 20, kB - 20) into sGlY
   Entity.SetPosition sGlPlayer, sGlX, sGlY, kZ
   Entity.SetRotation sGlPlayer, 0, sGlTicks * 0.04, 0
   -- the ring
   if Arc.Held(32) then
      put min(kGlRingMax, sGlRing + 4) into sGlRing
      subtract 0.28 from sGlStam
      Glaze.ShowRing
      if sGlRing >= kGlRingMax or sGlStam <= 0 then
         Glaze.Release
      end if
   else
      if sGlRing > 0 then Glaze.Release
      put min(100, sGlStam + 0.18) into sGlStam
   end if
   Glaze.Guards
   if sGlConv >= kGlNeed then
      put "THEY ALL CAME ROUND.  SPACE TO PLAY AGAIN" into sGlMsg
      put "won" into sGlState
      Arc.Won 3
   else if sGlStam <= 0 then
      put "GLAZE IS OUT OF WORDS.  SPACE TO TRY AGAIN" into sGlMsg
      put "lost" into sGlState
   end if
   Glaze.Hud
end Glaze.Step

on Glaze.ShowRing
   local tN
   put max(1, min(10, ceil(sGlRing / 20))) into tN
   if sGlRingId is empty then
      put Entity.Spawn("Glz.Ring" & tN, sGlX, sGlY, kZ, "magenta") into sGlRingId
   else
      Entity.SetMesh sGlRingId, "Glz.Ring" & tN
      Entity.SetPosition sGlRingId, sGlX, sGlY, kZ
   end if
end Glaze.ShowRing

-- let go: everyone inside the ring is talked round
on Glaze.Release
   local i, tGot
   put 0 into tGot
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false and Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) <= sGlRing then
         put true into sGlGuard[i]["conv"]
         Entity.SetColor sGlGuard[i]["id"], "cyan"
         add 1 to sGlConv
         add 1 to tGot
      end if
   end repeat
   if tGot > 0 then
      put tGot && "TALKED ROUND" into sGlMsg
      FX.Sparks sGlX, sGlY, kZ, 12, "magenta"
   else if sGlRing > 20 then
      put "THE RING CAUGHT NOBODY" into sGlMsg
   end if
   put 0 into sGlRing
   if sGlRingId is not empty then
      Entity.Kill sGlRingId
      put empty into sGlRingId
   end if
end Glaze.Release

on Glaze.Guards
   local i, j, tNearest, tBest, d, tSpeed, tTX, tTY, tLen
   -- a new guard now and then, from the edge
   add 1 to sGlSpawnClock
   if sGlSpawnClock >= max(26, 72 - sGlConv * 3) then
      put 0 into sGlSpawnClock
      if Glaze.Enemies() < 14 then Glaze.Spawn
   end if
   repeat with i = sGlN down to 1
      if sGlGuard[i] is empty then next repeat
      if sGlGuard[i]["conv"] is true then
         -- a convert hunts the nearest of its old friends, else follows Glaze
         put 0 into tNearest
         put 9999 into tBest
         repeat with j = 1 to sGlN
            if sGlGuard[j]["conv"] is false then
               put Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlGuard[j]["x"], sGlGuard[j]["y"]) into d
               if d < tBest then
                  put d into tBest
                  put j into tNearest
               end if
            end if
         end repeat
         put 4.5 into tSpeed
         if tNearest > 0 then
            put sGlGuard[tNearest]["x"] into tTX
            put sGlGuard[tNearest]["y"] into tTY
         else
            put sGlX + 40 into tTX
            put sGlY + 20 into tTY
         end if
      else
         put 1.1 + sGlConv * 0.07 into tSpeed
         put sGlX into tTX
         put sGlY into tTY
      end if
      put Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], tTX, tTY) into tLen
      if tLen > tSpeed then
         add (tTX - sGlGuard[i]["x"]) / tLen * tSpeed to sGlGuard[i]["x"]
         add (tTY - sGlGuard[i]["y"]) / tLen * tSpeed to sGlGuard[i]["y"]
      end if
      Entity.SetPosition sGlGuard[i]["id"], sGlGuard[i]["x"], sGlGuard[i]["y"], kZ
      Entity.SetRotation sGlGuard[i]["id"], 0, sGlTicks * 0.1, 0
   end repeat
   -- contacts: convert vs guard (both go), guard vs Glaze (the guard goes, she pays)
   repeat with i = sGlN down to 1
      if sGlGuard[i] is empty then next repeat
      if sGlGuard[i]["conv"] is false and Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) < 26 then
         subtract 20 from sGlStam
         put "A GUARD GOT THROUGH" into sGlMsg
         FX.Sparks sGlX, sGlY, kZ, 10, "red"
         Glaze.Remove i
         next repeat
      end if
      if sGlGuard[i]["conv"] is true then
         repeat with j = 1 to sGlN
            if j is not i and sGlGuard[j] is not empty and sGlGuard[j]["conv"] is false then
               if Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlGuard[j]["x"], sGlGuard[j]["y"]) < 24 then
                  FX.Sparks sGlGuard[j]["x"], sGlGuard[j]["y"], kZ, 8, "cyan"
                  -- remove the higher index first so the lower one stays valid
                  if i > j then
                     Glaze.Remove i
                     Glaze.Remove j
                  else
                     Glaze.Remove j
                     Glaze.Remove i
                  end if
                  exit repeat
               end if
            end if
         end repeat
      end if
   end repeat
end Glaze.Guards

function Glaze.Enemies
   local i, n
   put 0 into n
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false then add 1 to n
   end repeat
   return n
end Glaze.Enemies

on Glaze.Spawn
   local tSide, tX, tY
   put random(4) into tSide
   switch tSide
      case 1
         put kL + random(kR - kL) into tX
         put kT into tY
         break
      case 2
         put kL + random(kR - kL) into tX
         put kB into tY
         break
      case 3
         put kL into tX
         put kT + random(kB - kT) into tY
         break
      default
         put kR into tX
         put kT + random(kB - kT) into tY
   end switch
   add 1 to sGlN
   put empty into sGlGuard[sGlN]
   put tX into sGlGuard[sGlN]["x"]
   put tY into sGlGuard[sGlN]["y"]
   put false into sGlGuard[sGlN]["conv"]
   put Entity.Spawn("Glz.Guard", tX, tY, kZ, "#B060FF") into sGlGuard[sGlN]["id"]
end Glaze.Spawn

-- removing keeps the order: shift the rest down (counts are small)
on Glaze.Remove i
   local j
   Entity.Kill sGlGuard[i]["id"]
   repeat with j = i to sGlN - 1
      put sGlGuard[j + 1] into sGlGuard[j]
   end repeat
   delete variable sGlGuard[sGlN]
   subtract 1 from sGlN
end Glaze.Remove

function Glaze.State
   return sGlState && sGlConv && round(sGlStam) && sGlN && round(sGlRing)
end Glaze.State

-- test help: where the guards are
function Glaze.Near
   local i, tBest, d, tPick
   put 9999 into tBest
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false then
         put Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) into d
         if d < tBest then
            put d into tBest
            put i into tPick
         end if
      end if
   end repeat
   return tBest
end Glaze.Near

function Glaze.Count
   local i, tN
   repeat with i = 1 to sGlN
      if sGlGuard[i]["conv"] is false and Arc.Dist(sGlGuard[i]["x"], sGlGuard[i]["y"], sGlX, sGlY) <= sGlRing + 4 then add 1 to tN
   end repeat
   return tN + 0
end Glaze.Count

------------------------------------------------------------------------------------
-- 4  RUNAWAY RUNTIME   rung 5: two bodies, one brain
-- You are a runtime. One input drives every copy of you at once. SPACE starts a fresh copy at the
-- start tile, but never more than two at a time. A copy that steps on a HANG tile (red X, orange
-- Y) freezes and keeps its slot until you retire it (X key). A frozen copy still weighs down a
-- pad: the magenta B and the orange Y both hold every purple door open while something is on them.
-- Walls and other copies stop a copy; each copy is stopped on its own.
-- ARROWS move   SPACE new copy   X retire a frozen copy   N restart the room   Reach the gold E.
-- Five rooms. The rule set is mirrored by tests/run_solver.py, which proved every room winnable.
------------------------------------------------------------------------------------
local sRunCell, sRunLevel, sRunRows, sRunW, sRunH, sRunC, sRunN, sRunState, sRunMsg, sRunWait
local sRunLastDir, sRunHold, sRunSpawn, sRunDoors, sRunSolid, sRunMoves, sRunDoorOpen
constant kRunLevels = 5

function Runtime.Rows pLevel
   switch pLevel
      case 1
         return "#########" & cr & "#S.....E#" & cr & "#########"
      case 2
         return "############" & cr & "#S.B########" & cr & "##.#########" & cr & "##......D.E#" & cr & "############"
      case 3
         return "############" & cr & "#S..Y#######" & cr & "#.##########" & cr & "#......D..E#" & cr & "############"
      case 4
         return "###########" & cr & "#S.B#######" & cr & "##.########" & cr & "##..X..####" & cr & "##.####.###" & cr & "##.....D.E#" & cr & "###########"
      case 5
         return "##############" & cr & "#S.B##########" & cr & "##.###########" & cr & "##.#...D....E#" & cr & "##.#.#######.#" & cr & "##.#.#.....X.#" & cr & "##...#.###.###" & cr & "######Y#X...##" & cr & "##############"
   end switch
   return empty
end Runtime.Rows

on Runtime.Start
   put 1 into sRunLevel
   Runtime.Load
end Runtime.Start

on Runtime.Load
   local tText, y, x, tRow, tCh, tWalls, tFloor, tId, i
   Arc.Clean
   put Runtime.Rows(sRunLevel) into tText
   put empty into sRunRows
   put 0 into sRunH
   put 0 into sRunW
   repeat for each line tRow in tText
      add 1 to sRunH
      put tRow into sRunRows[sRunH]
      put max(sRunW, length(tRow)) into sRunW
   end repeat
   -- big rooms are drawn smaller, small rooms larger
   put min(56, 760 div sRunW, 430 div sRunH) into sRunCell
   Mesh.Define "Run.Copy", Mesh.Box(sRunCell * 0.5, sRunCell * 0.5, sRunCell * 0.5)
   Mesh.Define "Run.Flat", Mesh.Box(sRunCell * 0.7, sRunCell * 0.7, 3)
   Mesh.Define "Run.Door", Mesh.Box(sRunCell - 2, sRunCell - 2, 10)
   Mesh.Define "Run.DoorOpen", Mesh.Box(6, sRunCell - 2, 3)
   put Mesh.New() into tWalls
   put Mesh.New() into tFloor
   put empty into sRunDoors
   put 0 into sRunSolid
   repeat with y = 1 to sRunH
      repeat with x = 1 to length(sRunRows[y])
         put char x of sRunRows[y] into tCh
         if tCh is "#" then
            put Mesh.Merge(tWalls, Mesh.Transform(Mesh.Box(sRunCell - 2, sRunCell - 2, 10), 0, 0, 0, Runtime.WX(x - 1), Runtime.WY(y - 1), 0, empty)) into tWalls
         else
            put Mesh.Merge(tFloor, Mesh.Transform(Mesh.Box(sRunCell - 8, sRunCell - 8, 2), 0, 0, 0, Runtime.WX(x - 1), Runtime.WY(y - 1), 6, empty)) into tFloor
            if tCh is "S" then
               put (x - 1) & "," & (y - 1) into sRunSpawn
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "#2E6F8E")
            else if tCh is "E" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "yellow")
            else if tCh is "X" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "red")
            else if tCh is "Y" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "orange")
            else if tCh is "B" then
               get Entity.Spawn("Run.Flat", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ - 4, "magenta")
            else if tCh is "D" then
               put Entity.Spawn("Run.Door", Runtime.WX(x - 1), Runtime.WY(y - 1), kZ, "#B060FF") into tId
               put tId & "," after sRunDoors
            end if
         end if
      end repeat
   end repeat
   if sRunDoors is not empty then delete the last char of sRunDoors
   Mesh.Define "Run.Walls", tWalls
   Mesh.Define "Run.Floor", tFloor
   get Entity.Spawn("Run.Walls", 0, 0, kZ, "#3A5FA0")
   get Entity.Spawn("Run.Floor", 0, 0, kZ, "#1C3A55")
   put empty into sRunC
   put 0 into sRunN
   put 0 into sRunMoves
   put "play" into sRunState
   put empty into sRunMsg
   put 0 into sRunWait
   put empty into sRunLastDir
   put 0 into sRunHold
   put false into sRunDoorOpen
   Runtime.Add
   Runtime.Hud
end Runtime.Load

-- world place of a grid cell (0-based)
function Runtime.WX pCol
   return (pCol - (sRunW - 1) / 2) * sRunCell
end Runtime.WX

function Runtime.WY pRow
   return (pRow - (sRunH - 1) / 2) * sRunCell - 20
end Runtime.WY

-- the tile at a 0-based cell; anything outside is wall
function Runtime.Tile pX, pY
   if pX < 0 or pY < 0 or pY >= sRunH then return "#"
   if pX >= length(sRunRows[pY + 1]) then return "#"
   return char (pX + 1) of sRunRows[pY + 1]
end Runtime.Tile

-- a fresh copy at the start tile
on Runtime.Add
   local tX, tY
   put item 1 of sRunSpawn into tX
   put item 2 of sRunSpawn into tY
   add 1 to sRunN
   put empty into sRunC[sRunN]
   put tX into sRunC[sRunN]["x"]
   put tY into sRunC[sRunN]["y"]
   put false into sRunC[sRunN]["hung"]
   put Entity.Spawn("Run.Copy", Runtime.WX(tX), Runtime.WY(tY), kZ, "cyan") into sRunC[sRunN]["id"]
end Runtime.Add

on Runtime.Hud
   Arc.Line "Run.Title", "RUNAWAY RUNTIME   ROOM" && sRunLevel & "/" & kRunLevels, 0, 18
   Arc.Line "Run.Copies", "COPIES" && sRunN & "/2   MOVES" && sRunMoves, 1, 14
   Arc.Line "Run.Msg", sRunMsg, 2, 14
   Arc.Help "ARROWS: MOVE.  SPACE: NEW COPY.  X: RETIRE.  N: RESTART.  M: MENU"
end Runtime.Hud

function Runtime.DirKey
   if Arc.Held(65362) then return "U"
   if Arc.Held(65364) then return "D"
   if Arc.Held(65361) then return "L"
   if Arc.Held(65363) then return "R"
   return empty
end Runtime.DirKey

on Runtime.Step
   local tDir, tGo
   if sRunState is "won" then
      -- the last room: wait for the player; else go on after a short pause
      if sRunLevel >= kRunLevels then
         if Arc.Pressed(32) then
            Runtime.Start
         end if
      else
         add 1 to sRunWait
         if sRunWait >= 40 then
            add 1 to sRunLevel
            Runtime.Load
         end if
      end if
      exit Runtime.Step
   end if
   if Arc.Pressed(110) then
      Runtime.Load
      exit Runtime.Step
   end if
   if Arc.Pressed(32) then Runtime.Do "S"
   if Arc.Pressed(120) then Runtime.Do "K"
   put Runtime.DirKey() into tDir
   put false into tGo
   if tDir is empty then
      put empty into sRunLastDir
      put 0 into sRunHold
   else if tDir is not sRunLastDir then
      put tDir into sRunLastDir
      put 0 into sRunHold
      put true into tGo
   else
      add 1 to sRunHold
      if sRunHold >= 10 and (sRunHold - 10) mod 4 is 0 then put true into tGo
   end if
   if tGo then Runtime.Do tDir
   Runtime.Hud
end Runtime.Step

-- one action: U D L R, S (spawn) or K (retire): same rules as tests/run_solver.py
on Runtime.Do pAct
   local i, j, tDX, tDY, tNX, tNY, tT, tBlocked, tOpen, tMoved
   if pAct is "S" then
      if sRunN >= 2 then
         put "NO MORE THAN TWO COPIES" into sRunMsg
         exit Runtime.Do
      end if
      repeat with i = 1 to sRunN
         if sRunC[i]["x"] is item 1 of sRunSpawn and sRunC[i]["y"] is item 2 of sRunSpawn then
            put "THE START IS TAKEN" into sRunMsg
            exit Runtime.Do
         end if
      end repeat
      Runtime.Add
      put "TEST" & (sRunN - 1) && "STARTS" into sRunMsg
      exit Runtime.Do
   end if
   if pAct is "K" then
      repeat with i = 1 to sRunN
         if sRunC[i]["hung"] is true then
            Entity.Kill sRunC[i]["id"]
            repeat with j = i to sRunN - 1
               put sRunC[j + 1] into sRunC[j]
            end repeat
            delete variable sRunC[sRunN]
            subtract 1 from sRunN
            put "RETIRED A FROZEN COPY" into sRunMsg
            Runtime.Doors
            exit Runtime.Do
         end if
      end repeat
      exit Runtime.Do
   end if
   put 0 into tDX
   put 0 into tDY
   if pAct is "U" then put -1 into tDY
   if pAct is "D" then put 1 into tDY
   if pAct is "L" then put -1 into tDX
   if pAct is "R" then put 1 into tDX
   put Runtime.PadDown() into tOpen
   put false into tMoved
   repeat with i = 1 to sRunN
      if sRunC[i]["hung"] is true then next repeat
      put sRunC[i]["x"] + tDX into tNX
      put sRunC[i]["y"] + tDY into tNY
      put Runtime.Tile(tNX, tNY) into tT
      put false into tBlocked
      if tT is "#" then put true into tBlocked
      if tT is "D" and tOpen is false then put true into tBlocked
      repeat with j = 1 to sRunN
         if j is not i and sRunC[j]["x"] is tNX and sRunC[j]["y"] is tNY then put true into tBlocked
      end repeat
      if tBlocked is false then
         put tNX into sRunC[i]["x"]
         put tNY into sRunC[i]["y"]
         put true into tMoved
         if tT is "X" or tT is "Y" then
            put true into sRunC[i]["hung"]
            Entity.SetColor sRunC[i]["id"], "#777777"
            put "A COPY HUNG. START A FRESH ONE" into sRunMsg
         end if
         Entity.SetPosition sRunC[i]["id"], Runtime.WX(tNX), Runtime.WY(tNY), kZ
      end if
   end repeat
   if tMoved then add 1 to sRunMoves
   Runtime.Doors
   -- win: a running copy on the exit
   repeat with i = 1 to sRunN
      if sRunC[i]["hung"] is false and Runtime.Tile(sRunC[i]["x"], sRunC[i]["y"]) is "E" then
         put "won" into sRunState
         put 0 into sRunWait
         if sRunLevel >= kRunLevels then
            put "THE LAST ROOM.  A RUNTIME GOT OUT.  SPACE TO RUN AGAIN" into sRunMsg
            Arc.Won 4
         else
            put "ROOM CLEAR" into sRunMsg
         end if
         exit repeat
      end if
   end repeat
end Runtime.Do

-- is any copy (hung or not) on a pad?
function Runtime.PadDown
   local i, tT
   repeat with i = 1 to sRunN
      put Runtime.Tile(sRunC[i]["x"], sRunC[i]["y"]) into tT
      if tT is "B" or tT is "Y" then return true
   end repeat
   return false
end Runtime.PadDown

-- doors open or shut to match the pads
on Runtime.Doors
   local tId, tOpen
   put Runtime.PadDown() into tOpen
   if tOpen is sRunDoorOpen then exit Runtime.Doors
   put tOpen into sRunDoorOpen
   repeat for each item tId in sRunDoors
      if tOpen then
         Entity.SetMesh tId, "Run.DoorOpen"
      else
         Entity.SetMesh tId, "Run.Door"
      end if
   end repeat
end Runtime.Doors

function Runtime.State
   local i, tOut
   repeat with i = 1 to sRunN
      put sRunC[i]["x"] & "." & sRunC[i]["y"] & "." & sRunC[i]["hung"] & ";" after tOut
   end repeat
   return sRunState && sRunLevel && sRunN && tOut
end Runtime.State

-- test help: jump to a room
on Runtime.GoLevel pN
   put pN into sRunLevel
   Runtime.Load
end Runtime.GoLevel

------------------------------------------------------------------------------------
-- 5  SQUAD SHUFFLE  (Squad C)   rung 6: a permutation in real time
-- Three soldiers ride in three lanes: SCOUT (cyan pyramid), GUNNER (red box), MEDIC (green
-- prism). Gates come down the lanes; each lane shows the shape of soldier it needs. When a
-- gate lands, every lane whose soldier is the wrong shape costs the squad a heart.
-- LEFT / RIGHT rotate the squad, UP swaps lanes 1 and 2, DOWN swaps lanes 2 and 3.
-- From wave 8 the Cone re-parses gates: they flash white and two lanes swap their needs.
-- Clear 16 gates with the squad alive.   (The soldier roles are an invention of the author.)
------------------------------------------------------------------------------------
local sSqForm, sSqSol, sSqX, sSqGates, sSqN, sSqHP, sSqDone, sSqTicks, sSqClock, sSqState, sSqMsg, sSqPerfect
constant kSqNeed = 16
constant kSqLineY = 245

on Squad.Start
   local i
   Mesh.Define "Sq.A", Mesh.Pyramid(4, 16, 32)
   Mesh.Define "Sq.B", Mesh.Box(26, 26, 26)
   Mesh.Define "Sq.C", Mesh.Prism(6, 15, 28)
   Mesh.Define "Sq.Bar", Mesh.Box(380, 3, 3)
   Mesh.Define "Sq.Line", Mesh.Box(380, 2, 2)
   put "ABC" into sSqForm
   put empty into sSqSol
   repeat with i = 1 to 3
      put Squad.LaneX(i) into sSqX[i]
      put Entity.Spawn("Sq." & char i of "ABC", sSqX[i], kSqLineY, kZ, item i of "cyan,red,green") into sSqSol[i]
   end repeat
   get Entity.Spawn("Sq.Line", 0, kSqLineY + 30, kZ, "#555555")
   put empty into sSqGates
   put 0 into sSqN
   put 6 into sSqHP
   put 0 into sSqDone
   put 0 into sSqTicks
   put 60 into sSqClock
   put 0 into sSqPerfect
   put "play" into sSqState
   put empty into sSqMsg
   Squad.Hud
end Squad.Start

function Squad.LaneX pLane
   return (pLane - 2) * 120
end Squad.LaneX

on Squad.Hud
   Arc.Line "Sq.Title", "SQUAD SHUFFLE", 0, 18
   Arc.Line "Sq.Score", "GATES" && sSqDone & "/" & kSqNeed && "  HEARTS" && sSqHP && "  PERFECT" && sSqPerfect, 1, 14
   Arc.Line "Sq.Msg", sSqMsg, 2, 14
   Arc.Help "LEFT RIGHT: ROTATE.  UP: SWAP 1-2.  DOWN: SWAP 2-3.  M: MENU"
end Squad.Hud

on Squad.Step
   local i, tSpeed, tG
   if sSqState is not "play" then
      if Arc.Pressed(32) then Arc.Again "Squad"
      exit Squad.Step
   end if
   add 1 to sSqTicks
   -- the formation
   if Arc.Pressed(65361) then put (char 2 to 3 of sSqForm) & char 1 of sSqForm into sSqForm
   if Arc.Pressed(65363) then put (char 3 of sSqForm) & char 1 to 2 of sSqForm into sSqForm
   if Arc.Pressed(65362) then put (char 2 of sSqForm) & (char 1 of sSqForm) & char 3 of sSqForm into sSqForm
   if Arc.Pressed(65364) then put (char 1 of sSqForm) & (char 3 of sSqForm) & char 2 of sSqForm into sSqForm
   -- soldiers slide to their lanes: the entity of each shape follows the lane it is in
   repeat with i = 1 to 3
      put offset(char i of "ABC", sSqForm) into tG
      put Squad.Slide(sSqX[i], Squad.LaneX(tG)) into sSqX[i]
      Entity.SetPosition sSqSol[i], sSqX[i], kSqLineY, kZ
      Entity.SetRotation sSqSol[i], 0, sSqTicks * 0.05, 0
   end repeat
   -- a new gate when the last has come far enough
   add 1 to sSqClock
   if sSqClock >= max(70, 130 - sSqDone * 4) and sSqDone + sSqN < kSqNeed then
      put 0 into sSqClock
      Squad.Spawn
   end if
   put 3.2 + sSqDone * 0.18 into tSpeed
   repeat with i = sSqN down to 1
      add tSpeed to sSqGates[i]["y"]
      Squad.PlaceGate i
      -- the Cone re-parses a gate on its way down (from wave 8)
      if sSqGates[i]["re"] is true and sSqGates[i]["tell"] is 0 and sSqGates[i]["y"] > 20 then
         put 14 into sSqGates[i]["tell"]
         Squad.Tint i, "white"
      end if
      if sSqGates[i]["tell"] > 0 then
         subtract 1 from sSqGates[i]["tell"]
         if sSqGates[i]["tell"] is 1 then Squad.Reparse i
      end if
      if sSqGates[i]["y"] >= kSqLineY - 10 then Squad.Land i
   end repeat
   if sSqHP <= 0 then
      put "THE SQUAD IS DOWN.  SPACE TO TRY AGAIN" into sSqMsg
      put "lost" into sSqState
   else if sSqDone >= kSqNeed then
      put "THE ROAD IS CLEAR.  SPACE TO RIDE AGAIN" into sSqMsg
      put "won" into sSqState
      Arc.Won 5
   end if
   Squad.Hud
end Squad.Step

function Squad.Slide pFrom, pTo
   if abs(pTo - pFrom) <= 26 then return pTo
   if pTo > pFrom then return pFrom + 26
   return pFrom - 26
end Squad.Slide

-- a gate needs a permutation of A B C
on Squad.Spawn
   local tReq, tPick, i
   put item random(6) of "ABC,ACB,BAC,BCA,CAB,CBA" into tReq
   add 1 to sSqN
   put empty into sSqGates[sSqN]
   put tReq into sSqGates[sSqN]["req"]
   put kT into sSqGates[sSqN]["y"]
   put 0 into sSqGates[sSqN]["tell"]
   put false into sSqGates[sSqN]["re"]
   if sSqDone >= 7 and random(100) <= 55 then put true into sSqGates[sSqN]["re"]
   put empty into sSqGates[sSqN]["ids"]
   repeat with i = 1 to 3
      put Entity.Spawn("Sq." & char i of tReq, Squad.LaneX(i), kT, kZ, "white") into sSqGates[sSqN]["ids"][i]
   end repeat
   put Entity.Spawn("Sq.Bar", 0, kT + 24, kZ, "#888888") into sSqGates[sSqN]["ids"][4]
   Squad.Tint sSqN, "#CCCCCC"
end Squad.Spawn

on Squad.PlaceGate i
   local k
   repeat with k = 1 to 3
      Entity.SetPosition sSqGates[i]["ids"][k], Squad.LaneX(k), sSqGates[i]["y"], kZ
   end repeat
   Entity.SetPosition sSqGates[i]["ids"][4], 0, sSqGates[i]["y"] + 24, kZ
end Squad.PlaceGate

on Squad.Tint i, pColor
   local k
   repeat with k = 1 to 3
      Entity.SetColor sSqGates[i]["ids"][k], pColor
   end repeat
end Squad.Tint

-- two lanes of this gate swap their needs
on Squad.Reparse i
   local tReq, a, b, tA
   put sSqGates[i]["req"] into tReq
   put random(3) into a
   put (a mod 3) + 1 into b
   put char a of tReq into tA
   put char b of tReq into char a of tReq
   put tA into char b of tReq
   put tReq into sSqGates[i]["req"]
   repeat with a = 1 to 3
      Entity.SetMesh sSqGates[i]["ids"][a], "Sq." & char a of tReq
   end repeat
   put -1 into sSqGates[i]["tell"]
   Squad.Tint i, "#CCCCCC"
end Squad.Reparse

-- the gate reaches the squad: compare lane by lane
on Squad.Land i
   local k, tMiss, tReq
   put sSqGates[i]["req"] into tReq
   put 0 into tMiss
   repeat with k = 1 to 3
      if char k of sSqForm is not char k of tReq then add 1 to tMiss
   end repeat
   subtract tMiss from sSqHP
   add 1 to sSqDone
   if tMiss is 0 then
      add 1 to sSqPerfect
      put "PERFECT" into sSqMsg
      FX.Sparks 0, kSqLineY, kZ, 10, "green"
   else
      put tMiss && "WRONG" into sSqMsg
      FX.Sparks 0, kSqLineY, kZ, 12, "red"
   end if
   Squad.RemoveGate i
end Squad.Land

on Squad.RemoveGate i
   local k
   repeat with k = 1 to 4
      Entity.Kill sSqGates[i]["ids"][k]
   end repeat
   if i < sSqN then put sSqGates[sSqN] into sSqGates[i]
   delete variable sSqGates[sSqN]
   subtract 1 from sSqN
end Squad.RemoveGate

function Squad.State
   return sSqState && sSqDone && sSqHP && sSqN && sSqForm
end Squad.State

-- test help: the formation, and the lowest gate's need (empty when no gate)
function Squad.Form
   return sSqForm
end Squad.Form

function Squad.Need
   local i, tBest, tReq
   put -9999 into tBest
   repeat with i = 1 to sSqN
      if sSqGates[i]["y"] > tBest then
         put sSqGates[i]["y"] into tBest
         put sSqGates[i]["req"] into tReq
      end if
   end repeat
   return tReq
end Squad.Need

------------------------------------------------------------------------------------
-- THE SONNET ARCADE: the launcher. A menu card that runs each game's Start / Step as modules.
-- UP DOWN + SPACE (or the number keys) pick a game.  M comes back here.  Escape is the player's.
-- Win a game and the Sonnet reveals more of itself: fourteen lines, five games.
------------------------------------------------------------------------------------
local sArcMode, sArcSel, sArcWon, sArcSpin, sArcShapes

constant kArcGames = "Rain,Password,Glaze,Runtime,Squad"

function Arcade.Pre pN
   return item pN of kArcGames
end Arcade.Pre

function Arcade.Title pN
   return line pN of ("NONSENSE RAIN" & cr & "THE PASSWORD" & cr & "GLAZE OVER" & cr & "RUNAWAY RUNTIME" & cr & "SQUAD SHUFFLE")
end Arcade.Title

function Arcade.Blurb pN
   return line pN of ("CATCH THE VALID CODE, DODGE THE NONSENSE" & cr & "GUESS THE CONE'S PASSWORD IN EIGHT THROWS" & cr & "CHARM THE GUARDS ROUND, AT A PRICE" & cr & "TWO COPIES, ONE BRAIN, FIVE ROOMS" & cr & "REARRANGE THE SQUAD BEFORE THE GATE LANDS")
end Arcade.Blurb

-- fourteen lines; a game that is won shows its own
function Arcade.Sonnet
   return "PROMPT RUNS WHERE OTHER FEET WOULD STOP TO ASK," & cr & \
         "AND GLAZE CAN TALK A GUARD OUT OF HIS POST." & cr & \
         "THE PROBE WILL FLY AT ANY SHIELD OR MASK," & cr & \
         "AND THE CONE WILL SING THE ONE WHO HEARS IT MOST." & cr & \
         "HIS CODE IS NOISE THAT WEARS A SERIOUS FACE," & cr & \
         "A TOWER OF PURPLE SAYING NOTHING LOUD." & cr & \
         "BUT SQUAD C KEEPS ITS PROMISE TO THE PLACE," & cr & \
         "AND SHUFFLES TO THE GATE BEFORE THE CROWD." & cr & \
         "WHEN ONE COPY HANGS, A NEW ONE TAKES THE RUN," & cr & \
         "NO MORE THAN TWO, AND NEITHER ONE WILL WAIT:" & cr & \
         "THE FIRST ONE'S WORK IS OVER WHEN IT'S DONE," & cr & \
         "THE SECOND ONE'S ALREADY AT THE GATE." & cr & \
         "SO LET THE CONE KEEP ALL HIS NOISY ART," & cr & \
         "THE RUNTIME KEEPS ITS PLAYER AND ITS HEART."
end Arcade.Sonnet

-- which sonnet lines belong to which game
function Arcade.LinesOf pN
   return line pN of ("1,3" & cr & "4,6" & cr & "7,9" & cr & "10,12" & cr & "13,14")
end Arcade.LinesOf

on Game.OnStart
   Arc.Clean
   Mesh.Define "Arc.Prompt", Mesh.Box(30, 30, 30)
   Mesh.Define "Arc.Glaze", Mesh.Prism(6, 17, 32)
   Mesh.Define "Arc.Probe", Mesh.Box(60, 8, 8)
   Mesh.Define "Arc.Cone", Mesh.Pyramid(12, 22, 48)
   Mesh.Define "Arc.Sonnet", Mesh.Prism(14, 18, 30)
   put 1 into sArcSel
   put 0 into sArcMode
   put 0 into sArcSpin
   Arcade.Menu
end Game.OnStart

on Arcade.Menu
   local i, tCount, tXY
   Arc.Clean
   put 0 into sArcMode
   put empty into sArcShapes
   -- the cast, down the right side
   put Entity.Spawn("Arc.Prompt", 290, -170, kZ, "cyan") into sArcShapes[1]
   put Entity.Spawn("Arc.Glaze", 290, -90, kZ, "magenta") into sArcShapes[2]
   put Entity.Spawn("Arc.Probe", 290, -10, kZ, "yellow") into sArcShapes[3]
   put Entity.Spawn("Arc.Cone", 290, 70, kZ, "#B060FF") into sArcShapes[4]
   put Entity.Spawn("Arc.Sonnet", 290, 150, kZ, "orange") into sArcShapes[5]
   repeat with i = 1 to 5
      put Camera.WorldToScreen(290, -170 + (i - 1) * 80, kZ) into tXY
      if tXY is not empty then
         HUD.Set "Arc.Cast" & i, item i of "PROMPT,GLAZE,PROBE,CONE,SONNET", item 1 of tXY - 120, item 2 of tXY - 6, 10
      end if
   end repeat
   Arcade.MenuHud
end Arcade.Menu

on Arcade.MenuHud
   local i, tMark, tLines, tLine, tN, tFrom, tTo, tText, tAll
   Arc.Line "Arc.Title", "THE SONNET ARCADE", 0, 20
   Arc.Line "Arc.Sub", "PROMPT, GLAZE, PROBE, THE CONE, SQUAD C AND THE RUNAWAY RUNTIMES", 1, 10
   repeat with i = 1 to 5
      put "  " into tMark
      if i is sArcSel then put "+ " into tMark
      put tMark & i && Arcade.Title(i) into tText
      if sArcWon[i] is true then put tText && "  DONE" into tText
      Arc.Line "Arc.Item" & i, tText, 2 + i, 16
   end repeat
   Arc.Line "Arc.Blurb", Arcade.Blurb(sArcSel), 9, 11
   -- the sonnet: only the lines of games that are won
   put Arcade.Sonnet() into tAll
   put 0 into tN
   repeat with i = 1 to 5
      if sArcWon[i] is true then
         put Arcade.LinesOf(i) into tLines
         put item 1 of tLines into tFrom
         put item 2 of tLines into tTo
         repeat with tN = tFrom to tTo
            HUD.Set "Arc.Son" & tN, line tN of tAll, gViewLeft + 20, gViewBottom - 250 + tN * 15, 9
         end repeat
      end if
   end repeat
   Arc.Help "UP DOWN SPACE, OR 1-5.  M: BACK HERE.  WIN GAMES TO HEAR THE SONNET"
end Arcade.MenuHud

on Game.OnUpdate
   local tPre, i, tKey
   Arc.Begin
   if sArcMode is 0 then
      Arcade.MenuStep
   else if Arc.Pressed(109) then
      Arcade.Menu
   else
      put Arcade.Pre(sArcMode) into tPre
      send (tPre & ".Step") to me
   end if
   Arc.End
end Game.OnUpdate

on Arcade.MenuStep
   local i
   add 1 to sArcSpin
   repeat with i = 1 to 5
      Entity.SetRotation sArcShapes[i], sArcSpin * 0.02 * i, sArcSpin * 0.05, 0
   end repeat
   if Arc.Pressed(65362) then put max(1, sArcSel - 1) into sArcSel
   if Arc.Pressed(65364) then put min(5, sArcSel + 1) into sArcSel
   repeat with i = 1 to 5
      if Arc.Pressed(48 + i) then put i into sArcSel
   end repeat
   Arcade.MenuHud
   if Arc.Pressed(32) or Arc.Pressed(65293) or Arc.Pressed(13) then Arcade.Enter sArcSel
   repeat with i = 1 to 5
      if Arc.Pressed(48 + i) then Arcade.Enter i
   end repeat
end Arcade.MenuStep

on Arcade.Enter pN
   put pN into sArcSel
   put pN into sArcMode
   Arc.Clean
   send (Arcade.Pre(pN) & ".Start") to me
end Arcade.Enter

-- a game tells the arcade it was won
on Arc.Won pN
   put true into sArcWon[pN]
end Arc.Won

function Arcade.State
   local tPre
   if sArcMode is 0 then return "menu" && sArcSel
   put Arcade.Pre(sArcMode) into tPre
   dispatch function (tPre & ".State") to me
   return "mode" && sArcMode && the result
end Arcade.State

function Arcade.WonCount
   local i, n
   put 0 into n
   repeat with i = 1 to 5
      if sArcWon[i] is true then add 1 to n
   end repeat
   return n
end Arcade.WonCount

